# ── Required ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string. On Supabase use the pooler in Transaction mode (port 6543).
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Public URL of the site, no trailing slash. The admin panel lives at <this URL>/admin.
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
NEXT_PUBLIC_SITE_NAME=My Site

# Session signing secret, at least 32 characters (openssl rand -base64 32)
BETTER_AUTH_SECRET=

# Key for the REST API and MCP server, at least 32 characters (openssl rand -base64 32)
NEXTPRESS_API_KEY=

# ── Optional: isolated admin domain ──────────────────────────────────────────
# Serve the admin panel only on its own domain, e.g. https://admin.yourdomain.com
# Point that domain at the same deployment. /admin on the public domain then returns 404.
ADMIN_URL=

# ── Optional: Redis ──────────────────────────────────────────────────────────
# Shared rate limiting for the API and login across instances. Without it, limits are per instance.
# Any Redis-compatible URL works (Upstash, Redis Cloud, self-hosted). Use rediss:// for TLS.
REDIS_URL=

# ── Media storage ────────────────────────────────────────────────────────────
# local = files in apps/web/public/uploads (development only)
# s3    = any S3-compatible storage: Cloudflare R2, AWS S3, MinIO, Supabase Storage, Backblaze B2
STORAGE_DRIVER=local

# Required when STORAGE_DRIVER=s3
# Endpoint without bucket, e.g. https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
# "auto" for R2, the bucket region for AWS (e.g. ap-southeast-1)
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL that serves the bucket objects, no trailing slash
S3_PUBLIC_URL=https://media.yourdomain.com

# Maximum upload size in MB. Vercel functions accept request bodies up to 4.5 MB.
MAX_UPLOAD_SIZE_MB=4
